{% extends 'base.html.twig' %}

{% block title %}Paralipomènes - Message
{% endblock %}

{% block body %}

	<div class="grandeDivMessage">

		<h3 class="eagle texte-rouge objetMess"> Objet du message: 
			{% if message.objet %}
				{{message.objet}}
			{% else %}
				Sans objet
			{% endif %}
		</h3>
		<p class="eagle texte-rouge expeMess">
			Expediteur:
			{{message.expediteur}}
		</p>
		<p class="eagle texte-rouge corpsMess">
			{{message.contenu}}
		</p>

		{% if message.expediteur != user %}
			<a href="{{path('app_reponse_message', {id:message.id})}}" class="texte-beige fond-rouge eagle btnRep">
				Repondre
			</a>
		{% endif %}

		{% for pj in pieceJointes %}

			<div class="boitePj">
				<h4 class=" texte-rouge eagle titrePj">Chapitre numero:
					{{pj.Correction.numeroChapitre}}
				</h4>
				<div class="texte-rouge eagle corpsPj">
					{{pj.Correction.Contenu|raw}}
				</div>
			</div>

		{% endfor %}
		
	</div>


{% endblock %}
