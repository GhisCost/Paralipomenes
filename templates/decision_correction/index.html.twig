{% extends 'base.html.twig' %}

{% block title %}Paralipomènes - Décision correction
{% endblock %}

{% block body %}

	<div class="div-decision texte-rouge fond-beige">

		{% if correction == [] %}
			<a class="" href="{{path('app_debut_correction', {id:histoire.id})}}">
				<button id="btn-correction" class="fond-rouge texte-beige eagle ">
					Commencer à corriger
				</button>
			</a>

		{% else %}

			<a class="" href="{{path('app_page_correction', {id:histoire.id})}}">
				<button id="btn-correction" class="fond-rouge texte-beige eagle">
					Continuer à corriger
				</button>
			</a>

		{% endif %}

		<h4 class="titre-histoire lavish">{{histoire.titre}}</h4>
		<div class="eagle">
			{% for ch in chapitres %}
				<br>
				{{ch.contenu|raw}}
			{% endfor %}
		</div>

	</div>

{% endblock %}
