{% extends 'base.html.twig' %}

{% block title %}
	Paralipomènes - Correction
{% endblock %}

{% set hasQuill = true %}

{% block body %}

	<div class="div-correct">
		<div class="divHautCorrec">

			<div id="divBtnPublier">
				<a id="btnPublier" class="eagle texte-beige fond-rouge" href="{{path('app_recap_pre_publication', {id:histoire.id})}}">
					Publier l'histoire
				</a>
			</div>

			<div class="form-titre eagle texte-rouge">
				{{ form_start(formTitre) }}
				{{ form_row(formTitre.titre) }}
				{{ form_row(formTitre.enregistrer) }}
				{{ form_end(formTitre) }}
			</div>

			<a href="{{ path('app_creation_message', {id: correction.id})}}" class="lienMess eagle texte-beige">
				Faire valider la correction par l'auteur
			</a>
		</div>

		{{ form_start(formChapitre) }}

		{{ form_widget(formChapitre.contenu, {
        attr: { class: 'cacher' }}) }}

		<div id="editor"></div>

		<button type="submit" class="btn btn-primary eagle fond-rouge texte-beige">Enregistrer</button>

		{{ form_end(formChapitre) }}

		{% if suivant == 1 %}
			<div class="div-correc-suivant">
				<a href="{{ path('app_correction_suivante', { id: idCorrection }) }}">
					<button class="eagle fond-rouge texte-beige btn-suivant">
						Corriger chapitre Suivant
					</button>
				</a>
			</div>
		{% endif %}
		{% if precedent == 1 %}
			<div class="div-correc-precedent">
				<a href="{{ path('app_correction_precedente', { id: idCorrection }) }}">
					<button class="eagle fond-rouge texte-beige btn-precedent">
						Corriger chapitre Précédent
					</button>
				</a>
			</div>
		{% endif %}

	</div>

{% endblock %}
