{% extends 'base.html.twig' %}

{% block title %}
	Paralipomènes - Mon compte
{% endblock %}

{% block body %}
	<div class="form-compte eagle texte-rouge">

		<h4 class="titreCompte">Informations de compte</h4>

		{{ form_start(form) }}
		<div>

			{{form_row(form.email, {label: "Email"}) }}
			<button type="submit" class="fond-rouge texte-beige eagle" name='modif_email'>Modifier</button>
		</div>
		<div>
			{{ form_row(form.Username, 
            {label: "Pseudonyme"}) }}
			<button type="submit" class="fond-rouge texte-beige eagle" name='modif_username'>Modifier</button>
		</div>
		<div>
			{{ form_row(form.password, 
            {label: "Mot de passe"}) }}
			<button type="submit" class="fond-rouge texte-beige eagle" name='modif_password'>Modifier</button>
		</div>
		{{ form_end(form) }}
	</div>

	<div class="accesAdmin">

		{% if 'ROLE_ADMIN' in user.roles %}

			<a class="texte-beige" href="{{path('admin')}}">
				<button class="eagle texte-beige fond-rouge" name="admin">
					Page d'administration
				</button>
			</a>

		{% endif %}

		{% if 'ROLE_CORRECTEUR' in user.roles %}

			<a class="texte-beige" href="{{path('app_choix_correction')}}">
				<button class="eagle texte-beige fond-rouge" name="correcteur">
					Page de corrections
				</button>
			</a>

		{% endif %}

	</div>

	<div class="lancementHistoire eagle texte-rouge">

		{% if user.histoires is null  %}

			<p>Commencer à raconter votre histoire:</p>

			<a href="{{path('app_debut_histoire',{id: app.user.id})}}" class="texte-beige">
				<button class="eagle texte-beige fond-rouge" name="creation">
					Se lancer
				</button>
			</a>
		{% elseif user.histoires.statut.name == "ENCOURS" %}

			<p>Continuer à raconter mon histoire:</p>

			<a href="{{path('app_redaction_chapitre',{id: app.user.id})}}" class="texte-beige">
				<button class="eagle texte-beige fond-rouge">
					Recommencer
				</button>
			</a>

		{% elseif user.histoires.statut.name == "DEMANDE" %}

			<p class="eagle texte-rouge">La demande de correction de votre histoire a été envoyée.</p>

		{% elseif user.histoires.statut.name == "CORRECTION" %}

			<p class="eagle texte-rouge">
				La correction de votre histoire est en cours.
			</p>
		
		{% elseif user.histoires.statut.name == "PUBLIER" %}
			<p class="eagle texte-rouge">
			Votre histoire à été publiée, contactez un moderateur si vous souhaitez ajouter des chapitres.
			</p>
		{% endif %}


	</div>
{% endblock %}
