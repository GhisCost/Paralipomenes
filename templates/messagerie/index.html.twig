{% extends 'base.html.twig' %}

{% block title %}Paralipomènes - Messagerie
{% endblock %}

{% block body %}
	<div class="grandeDivMess">
		<div class="divMessRecu">
			<h4 class="eagle texte-rouge">Messages reçus</h4>
			{% for messRe in messagesRecus %}
				<a class="eagle texte-rouge " href="{{path('app_detail_message', {id:messRe.id})}}">
					Objet:
					{% if messRe.objet %}
						{{messRe.objet}}
					{% else %}
						Sans objet
					{% endif %}
					. 
					    Envoyé par:
					{{messRe.expediteur.email}}
					.
					    le:
					{{messRe.dateEnvoi|date('d/m/Y')}}
					.
				</a>
			{% endfor %}
		</div>

		<div class="divMessEnv">
			<h4 class="eagle texte-rouge">Messages Envoyés</h4>
			{% for messEnv in messagesEnvoyer %}
				<a class="eagle texte-rouge " href="{{path('app_detail_message', {id:messEnv.id})}}">
					Objet:
					{% if messEnv.objet %}
						{{messEnv.objet}}
					{% else %}
						Sans objet
					{% endif %}
					. 
					    Envoyé à:
					{{messEnv.destinataire.email}}
					.
					    le:
					{{messEnv.dateEnvoi|date('d/m/Y')}}
					.
				</a>
			{% endfor %}
		</div>
    </div>
	{% endblock %}
