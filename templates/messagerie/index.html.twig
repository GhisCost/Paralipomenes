{% extends 'base.html.twig' %}

{% block title %}Paralipomènes - Messagerie{% endblock %}

{% block body %}
<div class="grandeDivMess" >

<div class="divMessRecu">

{# <pre>
    {{ dump(messagesEnvoyer) }}
</pre> #}

</div>

<div class="divMessEnv">

{% for messEnv in messagesEnvoyer %}
    
    <a class="eagle texte-rouge " href="{{path('app_detail_message', {id:messEnv.id})}}"> Objet: 
    {% if messEnv.objet %} 
    {{messEnv.objet}}
    {% else %}
    Sans objet
    {% endif %} . 
    Envoyer par: {{messEnv.expediteur.email}}  .
    le: {{messEnv.dateEnvoi|date('d/m/Y')}} .
     </a>

{% endfor %}

</div>

</div>
{% endblock %}
