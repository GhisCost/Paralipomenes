{% extends 'base.html.twig' %}

{% block title %}
	Paralipomènes - redaction
{% endblock %}

{% set hasQuill = true %}

{% block body %}

	<div id="divSubmitCorrection">
		<button id="submitCorrection" class="eagle fond-rouge texte-beige">Soumettre votre histoire à la correction</button>
	</div>

	<div class="eagle fond-beige texte-rouge modalSubmitCorrec pasLa">
		<h3>Confirmation</h3>
		<p>Etes-vous certain de vouloir soumettre votre histoire à la correction ? 
		(Vous ne pourrez plus ajouter de nouveau chapitre avant la publication de votre histoire)</p>

		<div class="divBouttonModal">

			<button class="eagle fond-beige texte-rouge nonSubCorrect">Non</button>

			<a class="aSubCorrec" href="{{path('app_demande_correction',{ id: chapitre.histoires.id })}} ">
				<button class="eagle ouiSubCorrec fond-rouge texte-beige ">Oui</button>
			</a>

		</div>
	</div>

	<div class="form-titre eagle texte-rouge">
		{{ form_start(formTitre) }}
		{{ form_row(formTitre.titre) }}
		{{ form_row(formTitre.enregistrer) }}
		{{ form_end(formTitre) }}
	</div>

	<div class="conteneur-redac">


		<div class="regle-redac texte-rouge eagle">
			<ul>
				<li>Pas de propos raciste</li>
				<li>Pas de propos sexiste</li>
				<li>Pas de propos homophobe</li>
				<li>Tout propos tombant sous le coup de la loi est interdit.</li>
				<li>Merci de rester anonyme.</li>
				<li>Ne pas mettre de nom/prénom réel.</li>
				<li>Ne pas donner le nom de vos entreprises.</li>
				<li>Pas de propos à caractère sexuel.</li>
				<li>Pas d’histoire inventée.</li>
				<li>Essayer de rendre les lieux/personnes/entreprises le moins reconnaissables possibles.</li>
			</ul>
		</div>


		<div class="form-redac">
			{{ form_start(formChapitre) }}
			{{ form_widget(formChapitre.contenu, {attr: { class: 'cacher' }}) }}
			<div id="editor"></div>
			<button type="submit" class="btn btn-primary eagle fond-rouge texte-beige">Enregistrer</button>
			{{ form_end(formChapitre) }}

			<div class="div-suivant">
				<a href="{{ path('app_chapitre_suivant', { id: chapitre.id }) }}">
					<button class="eagle fond-rouge texte-beige btn-suivant">
						Chapitre Suivant
					</button>
				</a>
			</div>

			{% if chapitre.numeroChapitre > 1 %}
				<div class="div-precedent">
					<a href="{{ path('app_chapitre_precedent', { id: chapitre.id }) }}">
						<button class="eagle fond-rouge texte-beige btn-precedent">
							Chapitre Précédent
						</button>
					</a>
				</div>
			{% endif %}
		</div>

	</div>

{% endblock %}
